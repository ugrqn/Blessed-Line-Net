<Window x:Class="RetroNet.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="RetroNet Control" Width="500" Height="660" MinWidth="380" MinHeight="420" Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI" FontSize="14" Closing="OnClosing">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{DynamicResource Banner}" Padding="20,14">
      <DockPanel><StackPanel><TextBlock Text="RetroNet Control" FontSize="24" FontWeight="Bold" Foreground="White" /><TextBlock Text="Seçili bağdaştırıcı trafiği" Foreground="White" /></StackPanel><Button DockPanel.Dock="Right" Content="Tema değiştir" Click="ChangeTheme" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="10,5" /></DockPanel>
    </Border>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
      <TextBlock x:Name="StatusText" Text="Ölçüm başlatılıyor" Foreground="{DynamicResource Quiet}" />
      <ComboBox x:Name="AdapterBox" Margin="0,8,0,14" Height="32" SelectionChanged="AdapterChanged" />
      <Border Background="{DynamicResource Card}" CornerRadius="10" Padding="18" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="↓ İndirme" /><TextBlock x:Name="DownloadSpeed" Text="—" FontSize="27" FontWeight="Bold" Foreground="{DynamicResource Accent}" /><TextBlock x:Name="DownloadTotal" Text="Toplam —" /></StackPanel>
        <StackPanel Grid.Column="1"><TextBlock Text="↑ Yükleme" /><TextBlock x:Name="UploadSpeed" Text="—" FontSize="27" FontWeight="Bold" Foreground="{DynamicResource Accent}" /><TextBlock x:Name="UploadTotal" Text="Toplam —" /></StackPanel>
      </Grid></Border>
      <TextBlock Text="Yeni Sayaç" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,8" />
      <TextBox x:Name="CounterName" Text="İnternet kullanımı" Margin="0,0,0,6" ToolTip="Sayaç adı" />
      <ComboBox x:Name="DirectionBox" SelectedIndex="2" Margin="0,0,0,6"><ComboBoxItem Content="İndirme" /><ComboBoxItem Content="Yükleme" /><ComboBoxItem Content="İkisi" /></ComboBox>
      <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,4,0"><TextBlock Text="Kota (MB, isteğe bağlı)" /><TextBox x:Name="LimitBox" /></StackPanel>
        <StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBlock Text="Kaç MB kala uyar?" /><TextBox x:Name="WarningBox" Text="100" /></StackPanel>
      </Grid>
      <TextBlock Text="Limit eylemi: Yalnızca uyar" Foreground="{DynamicResource Quiet}" />
      <Button Content="Sayacı başlat" Click="AddCounter" Margin="0,8,0,8" Padding="8" Background="{DynamicResource Accent}" Foreground="White" />
      <TextBlock Text="Sayaçlar" FontSize="20" FontWeight="SemiBold" Margin="0,10,0,6" />
      <ItemsControl x:Name="CounterList" />
      <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{DynamicResource Quiet}" />
    </StackPanel></ScrollViewer>
  </DockPanel>
</Window>
