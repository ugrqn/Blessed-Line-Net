<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BlessedLine</AssemblyName>
    <RootNamespace>BlessedLine.Desktop</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <SatelliteResourceLanguages>tr</SatelliteResourceLanguages>
    <Product>BlessedLine</Product>
    <Version>0.3.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Resource Include="Assets/**/*" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.8" />
    <ProjectReference Include="../BlessedLine.Core/BlessedLine.Core.csproj" />
  </ItemGroup>
</Project>
