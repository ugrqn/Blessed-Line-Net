<Window x:Class="BlessedLine.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="BlessedLine" Icon="Assets/BlessedLine.ico" Width="550" Height="550" WindowStyle="None" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" FontFamily="{DynamicResource BodyFont}" FontSize="12"
        Background="{DynamicResource Base}" Foreground="{DynamicResource Ink}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" Loaded="OnLoaded" Closing="OnClosing">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="27" ResizeBorderThickness="0" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/XP.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <DrawingImage x:Key="SettingsIcon">
                <DrawingImage.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="#2A5E9A" Geometry="M 5,0 L 9,0 9,2 11,3 13,2 15,5 13,7 13,9 15,11 13,14 11,13 9,14 9,16 5,16 5,14 3,13 1,14 -1,11 1,9 1,7 -1,5 1,2 3,3 5,2 Z"/>
                        <GeometryDrawing Brush="#7AB8ED" Geometry="M 6,1 L 8,1 8,3 11,4 13,3 14,5 12,7 12,9 14,11 13,13 11,12 8,13 8,15 6,15 6,13 3,12 1,13 0,11 2,9 2,7 0,5 1,3 3,4 6,3 Z"/>
                        <GeometryDrawing Brush="#22456D" Geometry="M 7,4 A 4,4 0 1 1 7,12 A 4,4 0 1 1 7,4 Z"/>
                        <GeometryDrawing Brush="#F8F6DF" Geometry="M 7,6 A 2,2 0 1 1 7,10 A 2,2 0 1 1 7,6 Z"/>
                    </DrawingGroup>
                </DrawingImage.Drawing>
            </DrawingImage>
            <ContextMenu x:Key="AppRowContextMenu" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="{DynamicResource L_AppDetails}" Click="OpenRowMenuDetails"/>
                <MenuItem Header="{Binding FavoriteLabel}" IsEnabled="{Binding CanControl}" Click="ToggleFavorite"/>
            </ContextMenu>
            <Style x:Key="Pane" TargetType="Border">
                <Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
                <Setter Property="CornerRadius" Value="{DynamicResource PaneRadius}"/><Setter Property="Background" Value="{DynamicResource Surface}"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Border BorderBrush="{DynamicResource Edge}" BorderThickness="{DynamicResource EdgeWidth}" CornerRadius="{DynamicResource FrameRadius}">
        <DockPanel>
            <Border DockPanel.Dock="Top" Height="27" Background="{DynamicResource CaptionBrush}" CornerRadius="{DynamicResource FrameRadius}">
                <DockPanel Margin="8,0,4,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="MiniButton" Style="{DynamicResource CaptionButton}" Content="–" Click="ToggleMini" ToolTip="{DynamicResource L_MinimizeTopRight}"/>
                        <Button x:Name="HideButton" Style="{DynamicResource CaptionButton}" Content="×" Click="CloseWindow" ToolTip="{DynamicResource L_HideToTray}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image x:Name="BrandIcon" Width="17" Height="17" Margin="0,0,5,0"
                               Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <TextBlock Text="BlessedLine" Foreground="{DynamicResource CaptionInk}" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <DockPanel Margin="12,8,12,8">
                <DockPanel x:Name="NetworkPanel" DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button x:Name="SettingsButton" DockPanel.Dock="Right" Click="OpenSettings" Margin="6,0,0,0" AutomationProperties.Name="{DynamicResource L_Settings}">
                        <StackPanel Orientation="Horizontal"><Image Source="{StaticResource SettingsIcon}" Width="14" Height="14" Margin="0,0,4,0"/><TextBlock Text="{DynamicResource L_SettingsEllipsis}"/></StackPanel>
                    </Button>
                    <Button x:Name="WifiInfoButton" DockPanel.Dock="Right" Click="OpenWifiInfo" Margin="6,0,0,0"
                            Content="{DynamicResource L_WifiInfo}"/>
                    <ComboBox x:Name="Adapters" DockPanel.Dock="Right" MinWidth="98" MaxWidth="135" DisplayMemberPath="Label" SelectionChanged="AdapterChanged" AutomationProperties.Name="{DynamicResource L_Connection}"/>
                    <TextBlock x:Name="NetworkStatus" Text="{DynamicResource L_FindingNetworks}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <Border x:Name="QuotaPanel" DockPanel.Dock="Top" Style="{StaticResource Pane}" Padding="10,7" Margin="0,0,0,6">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock x:Name="QuotaPercent" DockPanel.Dock="Right" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                            <TextBlock x:Name="QuotaText" FontWeight="Bold" FontSize="14" Text="{DynamicResource L_TotalUsage}"/>
                        </DockPanel>
                        <Border Height="8" Background="{DynamicResource Alternate}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Margin="0,6,0,4">
                            <Grid x:Name="Track" SizeChanged="TrackResized">
                                <Border x:Name="TrackFill" Background="#459648" HorizontalAlignment="Left" Width="0"/>
                            </Grid>
                        </Border>
                        <DockPanel>
                            <Button x:Name="MiniQuotaButton" DockPanel.Dock="Right" Click="EditQuota" Visibility="Collapsed"
                                    ToolTip="{DynamicResource L_EditQuota}" AutomationProperties.Name="{DynamicResource L_EditQuota}">
                                <Image Source="{StaticResource SettingsIcon}" Width="14" Height="14"/>
                            </Button>
                            <Button x:Name="RestoreButton" DockPanel.Dock="Right" Content="{DynamicResource L_RestoreWifi}" Click="RestoreConnection" Visibility="Collapsed"/>
                            <Button x:Name="EditQuotaButton" DockPanel.Dock="Right" Content="{DynamicResource L_SetQuota}" Click="EditQuota"/>
                            <TextBlock x:Name="QuotaHint" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
                <Grid x:Name="RatesPanel" DockPanel.Dock="Top" Margin="4,0,4,8">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="{DynamicResource L_Download}" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="DownloadRate" FontWeight="Bold" FontSize="17" Text="—"/></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource L_Upload}" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="UploadRate" Text="—" FontWeight="Bold" FontSize="17"/></StackPanel>
                    <StackPanel Grid.Column="2" ToolTip="{DynamicResource L_PingTarget}"><TextBlock Text="Ping" Foreground="{DynamicResource Muted}"/>
                        <TextBlock x:Name="PingValue" Text="—" FontWeight="Bold" FontSize="17"/></StackPanel>
                </Grid>
                <Grid x:Name="MiniRates" DockPanel.Dock="Top" Visibility="Collapsed">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBlock FontWeight="Bold"><Run Text="↓ "/><Run Text="{Binding Text, ElementName=DownloadRate, Mode=OneWay}"/></TextBlock>
                    <TextBlock Grid.Column="1" FontWeight="Bold"><Run Text="↑ "/><Run Text="{Binding Text, ElementName=UploadRate, Mode=OneWay}"/></TextBlock>
                    <TextBlock Grid.Column="2" FontWeight="Bold" ToolTip="{DynamicResource L_PingTarget}"><Run Text="Ping "/><Run Text="{Binding Text, ElementName=PingValue, Mode=OneWay}"/></TextBlock>
                </Grid>
                <TextBlock x:Name="Feedback" DockPanel.Dock="Bottom" FontSize="11" Margin="0,3,0,0" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
                <Popup x:Name="QuotaPopup" PlacementTarget="{Binding ElementName=EditQuotaButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                    <Border Style="{StaticResource Pane}" Padding="12" Width="304">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource L_CounterAndQuota}" FontWeight="Bold" Margin="0,0,0,6"/>
                            <DockPanel><Button Content="{DynamicResource L_New}" DockPanel.Dock="Right" Click="NewCounter" Margin="4,0,0,0"/>
                                <ComboBox x:Name="Counters" DisplayMemberPath="Name" SelectionChanged="CounterChanged" AutomationProperties.Name="{DynamicResource L_Counter}"/></DockPanel>
                            <TextBlock Text="{DynamicResource L_LimitMb}" Margin="0,8,0,3"/>
                            <DockPanel>
                                <Button x:Name="ApplyLimitButton" Content="{DynamicResource L_Apply}" DockPanel.Dock="Right" Click="SetLimit" Margin="4,0,0,0"/>
                                <TextBox x:Name="LimitInput" VerticalContentAlignment="Center" MaxLength="16" AutomationProperties.Name="{DynamicResource L_LimitMb}"/></DockPanel>
                            <DockPanel Margin="0,7,0,2">
                                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0" Text="{DynamicResource L_WarningBeforeMb}"/>
                                <TextBox x:Name="WarningInput" Width="72" HorizontalAlignment="Right" MaxLength="16"
                                         AutomationProperties.Name="{DynamicResource L_WarningBeforeMb}"/>
                            </DockPanel>
                            <WrapPanel Margin="0,5,0,0">
                                <Button x:Name="LowerButton" Content="−100 MB" Click="LowerLimit"/>
                                <Button x:Name="ExtendButton" Content="+100 MB" Click="ExtendLimit" Margin="4,0,0,0"/>
                            </WrapPanel>
                            <CheckBox x:Name="BlockCheck" Content="{DynamicResource L_WifiAtQuota}" Checked="ArmBlock" Unchecked="DisarmBlock" Margin="0,8"/>
                            <WrapPanel><Button x:Name="PauseButton" Click="PauseCounter"/><Button Content="{DynamicResource L_Reset}" Margin="4,0" Click="ResetCounter"/><Button Content="{DynamicResource L_Delete}" Click="DeleteCounter"/></WrapPanel>
                        </StackPanel>
                    </Border>
                </Popup>
                <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=SettingsButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                    <Border Style="{StaticResource Pane}" Padding="12" Width="310">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource L_Language}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="LanguageList" DisplayMemberPath="Name" SelectedValuePath="Code" SelectionChanged="LanguageChanged" Margin="0,0,0,8"/>
                            <TextBlock Text="{DynamicResource L_Theme}" FontWeight="Bold" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="XpThemeOption" GroupName="Theme" Content="{DynamicResource L_ClassicTheme}" Checked="ThemeChanged" Margin="0,3,12,3"/>
                                <RadioButton x:Name="AeroThemeOption" GroupName="Theme" Content="Windows 7 Aero" Checked="ThemeChanged" Margin="0,3"/>
                            </StackPanel>
                            <CheckBox x:Name="PinDetails" Content="{DynamicResource L_AppsInMain}" Click="RememberDetails" Margin="0,10,0,4"/>
                            <CheckBox x:Name="PinMiniDetails" Content="{DynamicResource L_AppsInMini}" Click="RememberDetails" Margin="0,0,0,10"/>
                            <CheckBox x:Name="StartupCheck" Content="{DynamicResource L_StartWithWindows}" Checked="StartupChanged" Unchecked="StartupChanged" Margin="0,0,0,10"/>
                            <CheckBox x:Name="AutoMeasureCheck" Content="{DynamicResource L_AutoMeasure}" Checked="AutoMeasureChanged" Unchecked="AutoMeasureChanged" Margin="0,0,0,10"/>
                            <CheckBox x:Name="UsageColors" Content="{DynamicResource L_UsageColors}" Checked="UsageColorsChanged"
                                      Unchecked="UsageColorsChanged" ToolTip="{DynamicResource L_UsageLegend}" Margin="0,0,0,10"/>
                            <TextBlock Text="{DynamicResource L_AlertSound}" Margin="0,0,0,4"/>
                            <DockPanel><Button DockPanel.Dock="Right" Content="{DynamicResource L_PreviewSound}" Click="PreviewSound" Margin="4,0,0,0"/>
                                <ComboBox x:Name="Sounds" SelectionChanged="SoundChanged"><ComboBoxItem Content="{DynamicResource L_StandardSound}"/><ComboBoxItem Content="{DynamicResource L_SoftSound}"/><ComboBoxItem Content="{DynamicResource L_StrongSound}"/></ComboBox></DockPanel>
                        </StackPanel>
                    </Border>
                </Popup>
                <DockPanel x:Name="AppsPanel">
                    <DockPanel DockPanel.Dock="Top" Margin="0,2,0,4">
                        <Button x:Name="ClearPoliciesButton" DockPanel.Dock="Right" Click="ClearAllPolicies"
                                FontFamily="Segoe MDL2 Assets" Content="&#xE777;" Width="27" Margin="5,0,0,0"
                                ToolTip="{DynamicResource L_ClearAllPolicies}" AutomationProperties.Name="{DynamicResource L_ClearAllPolicies}"/>
                        <Button x:Name="DetailsButton" DockPanel.Dock="Right" Click="ToggleDetails"><TextBlock x:Name="DetailsLabel"/></Button>
                        <Button x:Name="AuthorizeButton" DockPanel.Dock="Right" Content="{DynamicResource L_MeasureRates}" Click="Authorize" Margin="0,0,5,0"/>
                        <TextBlock Text="{DynamicResource L_Applications}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock x:Name="DetailStatus" DockPanel.Dock="Bottom" Margin="0,3,0,0" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
                    <Grid>
                        <DataGrid x:Name="Applications" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserResizeRows="False"
                                  CanUserReorderColumns="False" HeadersVisibility="Column" RowHeight="26" ColumnHeaderHeight="23"
                                  BorderBrush="{DynamicResource Line}" Background="{DynamicResource Surface}" RowBackground="{DynamicResource Surface}"
                                  AlternatingRowBackground="{DynamicResource Alternate}" GridLinesVisibility="None" EnableRowVirtualization="True"
                                  HorizontalScrollBarVisibility="Auto" FontSize="11" Sorting="SortApplicationColumn" PreviewKeyDown="AppListKeyDown">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <EventSetter Event="MouseDoubleClick" Handler="OpenRowDetails"/>
                                    <Setter Property="ContextMenu" Value="{StaticResource AppRowContextMenu}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UsageLevel}" Value="1"><Setter Property="Background" Value="#FFF3D6"/></DataTrigger>
                                        <DataTrigger Binding="{Binding UsageLevel}" Value="2"><Setter Property="Background" Value="#FCE7E7"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn x:Name="AppColumn0" Header="" Width="*" MinWidth="100" SortMemberPath="Name">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <Grid ToolTip="{Binding Details}"><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <Image Source="{Binding Icon}" Width="16" Height="16"/>
                                            <DockPanel Grid.Column="1">
                                                <TextBlock DockPanel.Dock="Left" Text="★" Foreground="#80560C" Margin="0,0,3,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers><DataTrigger Binding="{Binding Favorite}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                        </Grid>
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn x:Name="AppColumn1" Header="" Binding="{Binding DownloadRateText}" SortMemberPath="DownloadRate" Width="64"/>
                                <DataGridTextColumn x:Name="AppColumn2" Header="" Binding="{Binding UploadRateText}" SortMemberPath="UploadRate" Width="64"/>
                                <DataGridTextColumn x:Name="AppColumn3" Header="" Binding="{Binding ReceivedText}" SortMemberPath="Received" Width="64"/>
                                <DataGridTextColumn x:Name="AppColumn4" Header="" Binding="{Binding SentText}" SortMemberPath="Sent" Width="64"/>
                                <DataGridTemplateColumn Width="29" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <Button Click="QuickAppPolicy" IsEnabled="{Binding CanControl}" Content="{Binding GateGlyph}"
                                                FontFamily="Segoe MDL2 Assets" FontSize="11" Padding="0"
                                                ToolTip="{Binding GateLabel}" AutomationProperties.Name="{Binding GateLabel}"/>
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="EmptyApps" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" TextAlignment="Center"/>
                    </Grid>
                </DockPanel>
            </DockPanel>
        </DockPanel>
    </Border>
</Window>
