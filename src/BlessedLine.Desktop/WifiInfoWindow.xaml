<Window x:Class="BlessedLine.Desktop.WifiInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L_WifiInfo}" Icon="Assets/BlessedLine.ico" Width="540" Height="388"
        MinWidth="450" MinHeight="320" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Base}" Foreground="{DynamicResource Ink}"
        FontFamily="{DynamicResource BodyFont}" FontSize="13" UseLayoutRounding="True">
    <DockPanel Margin="14">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button x:Name="WifiRefresh" Content="{DynamicResource L_WifiRefresh}" Click="Refresh" Margin="0,0,6,0"/>
            <Button x:Name="WifiScan" Content="{DynamicResource L_WifiScan}" Click="Scan" Margin="0,0,6,0"/>
            <Button Content="{DynamicResource L_WindowsWifi}" Click="OpenWindowsWifi" Margin="0,0,6,0"/>
            <Button x:Name="LocationButton" Content="{DynamicResource L_WifiLocation}" Click="OpenLocation" Visibility="Collapsed"/>
        </WrapPanel>
        <TextBlock x:Name="WifiStatus" DockPanel.Dock="Bottom" Margin="0,7,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/>
        <TabControl>
            <TabItem Header="{DynamicResource L_WifiConnected}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="Overview" Padding="12" TextWrapping="Wrap"/>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{DynamicResource L_NearbyWifi}">
                <DockPanel Margin="6">
                    <TextBlock x:Name="SelectedNetwork" DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="0,7,0,0"/>
                    <DataGrid x:Name="NearbyNetworks" IsReadOnly="True" AutoGenerateColumns="False"
                              CanUserAddRows="False" EnableRowVirtualization="True" SelectionChanged="SelectNetwork">
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="NetworkColumn" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn x:Name="SignalColumn" Binding="{Binding Quality, StringFormat={}{0}%}" Width="70"/>
                            <DataGridTextColumn x:Name="SecurityColumn" Binding="{Binding Security}" Width="125"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
