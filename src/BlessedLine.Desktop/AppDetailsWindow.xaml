<Window x:Class="BlessedLine.Desktop.AppDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BlessedLine" Icon="Assets/BlessedLine.ico" Width="460" MinWidth="400"
        SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="CanMinimize"
        Background="{DynamicResource Base}" Foreground="{DynamicResource Ink}"
        FontFamily="{DynamicResource BodyFont}" FontSize="13" UseLayoutRounding="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="640">
        <StackPanel Margin="16">
            <DockPanel>
                <Image x:Name="ProgramIcon" Width="27" Height="27" Margin="0,0,8,0"/>
                <TextBlock x:Name="ProgramName" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
            <TextBlock x:Name="ProgramPath" Margin="0,5,0,10" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap"/>
            <TextBlock Text="{DynamicResource L_RateHistory}" FontWeight="SemiBold"/>
            <Border x:Name="GraphHost" Height="104" Margin="0,5,0,6" AutomationProperties.Name="{DynamicResource L_RateHistory}"/>
            <TextBlock x:Name="RateSummary" Margin="0,0,0,12" TextWrapping="Wrap"/>
            <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="10" Background="{DynamicResource Surface}">
                <StackPanel>
                    <DockPanel>
                        <Button x:Name="RestorePolicyButton" DockPanel.Dock="Right" Click="Clear" Content="{DynamicResource L_ClearAppPolicy}" Margin="6,0,0,0"/>
                        <Button x:Name="BlockPolicyButton" Click="Toggle"/>
                    </DockPanel>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="80"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource L_UploadCap}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <TextBox x:Name="UploadCapInput" Grid.Column="1" Margin="6,0" MaxLength="8" VerticalContentAlignment="Center"
                                 AutomationProperties.Name="{DynamicResource L_UploadCap}"/>
                        <Button x:Name="ApplyUploadCap" Grid.Column="2" Content="{DynamicResource L_Apply}" Click="ApplyUpload"/>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="80"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource L_AppQuota}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <TextBox x:Name="AppQuotaInput" Grid.Column="1" Margin="6,0" MaxLength="16" VerticalContentAlignment="Center"
                                 AutomationProperties.Name="{DynamicResource L_AppQuota}"/>
                        <Button x:Name="ApplyAppQuota" Grid.Column="2" Content="{DynamicResource L_Apply}" Click="ApplyQuota"/>
                    </Grid>
                    <TextBlock x:Name="PolicyState" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/>
                </StackPanel>
            </Border>
            <TextBlock x:Name="ActionStatus" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</Window>
